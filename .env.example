# Environment variables for Graveyard of Dead Software
# Copy this to .env and fill in real values

BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_project_id_here
GROQ_API_KEY=your_groq_api_key_here

# Gemma provider: "groq" | "ollama"
GEMMA_PROVIDER=ollama

# Ollama settings (if using local Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3

# Groq Gemma model
GROQ_MODEL=gemma2-9b-it

# App settings
DATABASE_URL=sqlite+aiosqlite:///./graveyard.db
SECRET_KEY=change-me-in-production

# Sentry (get your DSN from sentry.io -> Project Settings -> Client Keys)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
